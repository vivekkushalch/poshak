# Copy to .env and fill in. NEVER commit the real .env.
API_KEY=change-me-long-random
DISABLE_AUTH=0
MODEL_TAG=siglip-base-patch16-224-v2-768

# Public S3 base for <img> display (frontends append /uploads/<f> or /rmbg/<f>)
IMAGE_BASE_URL=https://your-bucket.s3.amazonaws.com

# S3 cold-start source (seed only)
S3_BUCKET=your-bucket
S3_REGION=ap-south-1
S3_UPLOADS_PREFIX=uploads/
S3_RMBG_PREFIX=rmbg/
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
