# Copy to .env and fill in. NEVER commit the real .env.
API_KEY=change-me-long-random
DISABLE_AUTH=0
MODEL_TAG=siglip-base-patch16-224-v2-768

# Public base for <img> display (the real frontend appends /uploads/<f> or /rmbg/<f>)
IMAGE_BASE_URL=https://your-public-image-host

# External background-removal API (indexing primary; local U2Net is the fallback)
# REMBG_API_URL=https://your-birefnet-service   # unset = local U2Net only
# REMBG_API_TIMEOUT=360      # seconds per image (birefnet is slow)
# REMBG_API_RETRIES=1        # retries before per-image local fallback
# REMBG_DEFAULT_ENGINE=auto  # auto | api | local
# REMBG_API_MAX_H=0          # downscale-by-height before upload to cut time; 0 = off

# Host dir holding all durable state (bind-mounted into the container).
# Created on the server; back it up with: tar czf poshak-backup.tgz ~/poshak
POSHAK_HOME=/home/ubuntu/poshak
