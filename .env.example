# Copy to .env and fill in. Never commit the real .env.

# --- auth (required unless DISABLE_AUTH=1) ---
API_KEY=change-me-long-random
DISABLE_AUTH=0

# --- storage: local (default) or s3 ---
STORAGE_BACKEND=local
# S3_BUCKET=my-catalog            # required when STORAGE_BACKEND=s3
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=                # set for MinIO / Cloudflare R2

# --- public image host the browser pages load photos from ---
IMAGE_BASE_URL=https://your-public-image-host

# --- optional remote background removal at index time (unset = local U2Net) ---
# REMBG_API_URL=https://your-birefnet-service
# REMBG_API_TIMEOUT=360
# REMBG_API_RETRIES=1
# REMBG_DEFAULT_ENGINE=auto       # auto | api | local
# REMBG_API_MAX_H=0               # downscale before upload; 0 = off

# --- capacity ---
# MAX_CONCURRENT_SEARCHES=2       # extra searches wait, then get 503
# SIFT_WORKERS=4
# Ranking: legacy (default) or v2, the progressive ranker for small catalogs (ADR 0006).
# After switching to v2 run `poshak refresh-descriptors` once. v2 serves a category only
# while it has at most V2_MAX_VIEWS photos; above that, searches use legacy.
# Public demo: reject every write except search, and serve clickable sample queries
# (a folder with index.json and the images) on the search page.
# READ_ONLY=0
# SAMPLES_DIR=
# RANKER=legacy
# V2_MAX_VIEWS=1000
# LOG_LEVEL=INFO

# --- host directory for compose.prod.yaml ---
POSHAK_HOME=/home/ubuntu/poshak
